generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model EducationLevel {
  id          String  @id @default(uuid())
  name        String  @unique
  slug        String  @unique
  description String?

  programs     Program[]
  noteRequests NoteRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Program {
  id          String  @id @default(uuid())
  name        String
  slug        String
  description String?

  educationLevelId String
  educationLevel   EducationLevel @relation(fields: [educationLevelId], references: [id], onDelete: Cascade)

  subjects     Subject[]
  noteRequests NoteRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([educationLevelId, name])
  @@unique([educationLevelId, slug])
  @@index([educationLevelId])
}

model Subject {
  id          String  @id @default(uuid())
  name        String
  slug        String
  code        String?
  description String?

  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  topics       Topic[]
  noteRequests NoteRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programId, name])
  @@unique([programId, slug])
  @@index([programId])
}

model Topic {
  id          String  @id @default(uuid())
  name        String
  slug        String
  description String?

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  notes        Note[]
  noteRequests NoteRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectId, name])
  @@unique([subjectId, slug])
  @@index([subjectId])
}

model Note {
  id          String  @id @default(uuid())
  title       String
  slug        String
  description String?

  topicId String
  topic   Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  resources NoteResource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([topicId, slug])
  @@index([topicId])
}

model NoteResource {
  id String @id @default(uuid())

  noteId String
  note   Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  type     NoteResourceType
  title    String?
  url      String
  publicId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([noteId])
}

enum NoteResourceType {
  PDF
  DOCUMENT
  PRESENTATION
  IMAGE
  VIDEO
  EXTERNAL_LINK
}

model Admin {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  passwordHash String

  isActive Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?
}

model NoteRequest {
  id String @id @default(uuid())

  name    String
  email   String
  message String

  educationLevelId String?
  educationLevel   EducationLevel? @relation(fields: [educationLevelId], references: [id], onDelete: SetNull)

  programId String?
  program   Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  topicId String?
  topic   Topic? @relation(fields: [topicId], references: [id], onDelete: SetNull)

  status NoteRequestStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([educationLevelId])
  @@index([programId])
  @@index([subjectId])
  @@index([topicId])
}

enum NoteRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}